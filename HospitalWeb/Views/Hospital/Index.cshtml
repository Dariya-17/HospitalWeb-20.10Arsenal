 @model IEnumerable<HospitalWeb.ViewModels.Hospital.HospitalIndexViewModel>
@{
    ViewData["Title"] = "Index";
}
<h1>Hospitals</h1>
<p>
    <a asp-action="Create">Create New</a>
    <a asp-controller="Doctor" asp-action="Index">Show all doctors</a>
</p>
@*Formata za tursene*@
<form asp-controller="Hospital" asp-action="Index" method="get">
   
    <div class="col-md-4">
        <label class="form-label">Hospital Name</label>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"            
                placeholder="Search by name..."/>
    </div>
    <div class="col-md-3">

        <label class="form-label">Minimum Beds</label>

        <input type="number"
               name="minBeds"
               value="@ViewBag.MinBeds"
               min="0"
               class="form-control" />
              
    </div>
  <div class="col-md-3">
      <label class="form-label">Sort by</label>

      <select name="sortOrder" class="form-control">

          <optin value="name"
              selected="@(ViewBag.SortOrder == "name")">
              Name A-Z

                <optin value="beds_asc"
                       selected="@(ViewBag.SortOrder == "beds_asc")">
                    Beds Ascending

                    <optin value="beds_desc"
                           selected="@(ViewBag.SortOrder == "beds_desc")">
                        Beds Descending
          </optin>
      </select>

  </div>
  <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">
            Search
            </button>
  </div>
    </form>
<table class="table"> 
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model=>model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model=>model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BedsCount)
            </th>
            <th>

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in @Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem=>item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.BedsCount)</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
